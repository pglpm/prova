@Article{truesdell1975,
author =       {Truesdell, III, Clifford Ambrose},
title =        {Early kinetic theories of gases},
journal =      ahes,
year =         {1975},
volume =       {15},
number =       {1},
pages =        {1--66},
keywords =     {thermodynamics, kinetic theory, statistical mechanics},
mynote =       {\enquote{The reader who has heard some very early names brought forward in candidature for proposing the kinetic theory will not find many of them repeated here. In excuse I can do no better than quote what \textsc{Jochmann} wrote in 1864 on p.~324 of the \emph{\langnohyph{Fortschritte der Physik}} \textbf{18} (1862). Those were the days when physicists had studied the classics and could read Greek. \textsc{Jochmann} sarcastically overtopped a spate of pretensions of antique priority: ``Even \textsc{Herakleitos} the Obscure of Ephesos, were he yet living, would not fail to make his claims of priority for discovery of the mechanical theory of heat.'' For the basis \textsc{Jochmann} quotes we now have a purer text (\textsc{Diels} B90), which I translate as follows: ``Everything is in exchange for fire, and fire for all things, just as goods for gold and for gold, goods.'' As \textsc{Jochmann} concluded, ``Does not this contain the equivalence of heat and work? Only the numerical constant is wanting!''} p.~53}
}


@InCollection{vansoest1956,
author =       {J. L. {van Soest}},
title =        {Some consequences of the finiteness of information},
booktitle =    {\NoCaseChange{\citein{cherry1956}}},
year =         {1956},
chapter =      {\chapb~1},
pages =        {3--7},
note =         {With discussion by D. M. MacKay, R. A. Fairthorne, J. Loeb, B. O. Koopman, D. A. Bell, and reply},
keywords =     {Bayes, communication theory, weight of evidence, decision theory, machine learning, neural networks},
mynote =       {\enquote{The perplexities referred to here are but a special case of the difficulties which come from ignoring the fundamental fact that the quantity of information is not an attribute of \emph{one} probability distribution but of a \emph{pair} of distributions (such as the \emph{a priori} $\{q_i\}$ and \emph{a posteriori} ${p_i}$ in the expression $\sum_i p_i \log p_i/q_i$ for the `cross entropy' of Good, Bartlett, and others). In the simple negentropy formula $\sum_i p_i \log p_i$ the second distribution is concealed; it may be taken as the enumerative set function giving the number of states in any sub-set of states. Whatever the terms of reference, one ignores the second distribution only at one's own risk; to begin with, the preceding type of one-distribution expressions are (in the continuous case) not invariant and can be made to have any value, merely by changing variables: $x = f(y)$ in $\int p(x) \log p(x)\, dx$. Secondly, even in the finite case, one is led to all the paradoxes of probability theory by the application of the `principle of sufficient reason', such as the `life on Mars' paradox.} Discussion p.~6}
}


note =         {\doi{10.1007/978-1-4757-4286-2}. First publ.\ 1980},
keywords =     {probability theory},
mynote =       {\begin{quotation}there are deep philosophical issues concerning the origin of models. Take, for instance, the very simple experiment of spinning a coin $n$ times and observing the sequence of heads and tails. It is standard to model this by assuming: (i) that the outcomes of the spins are ``independent''; and (ii) that the probability of each outcome being a head is some common value $\theta$. \textelp{}\par Consider, however, the two assumptions that went into the above construction. It is difficult, and perhaps impossible, to give precise and operationally realizable definitions of independence and of $\theta$ that are not subjective. For instance, the frequentist definition of $\theta$ involves some limiting average in a long series of ``independent'' spins of the coin. Besides the confounding with independence, the definition really involves an imaginary thought experiment, since (in reality) the coin would obviously be changing (minutely) from spin to spin. Likewise, one cannot really define independence without reference to imaginary situations.\end{quotation} \sect3.5.7 pp.~104--105},
origdate =     {1980}
}


note =         {\doi{10.1080/00031305.2016.1154108} supplemental material. See \citebi{asa2016} and \citebi{wassersteinetal2016}},
mynote =       {\enquote{Ironically though, the same null bias found in significance tests is tightly integrated into the confirmationist version of ``objective Bayesian'' testing, which assigns a spike (point prior mass) to test a point null hypothesis against a continuous composite alternative (Jeffreys 1961; Berger and Sellke 1987). That isolated spike identifies the null as the point with special added cost to falsely reject, and the mass of the spike is a surrogate for that added cost. Again Neyman's example should be borne in mind, for in such cases the spike serves only the parties invested in maintaining the null.} S. Greenland, \emph{The ASA Guidelines and Null Bias in Current Teaching and Practice}}

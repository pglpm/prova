@Article{davisetal2014,
author =       {Richard S. Davis and Martin J. T. Milton},
title =        {The assumption of the conservation of mass and its implications for present and future definitions of the kilogram and the mole},
journal =      metrol,
year =         {2014},
volume =       {51},
number =       {3},
pages =        {169--173},
note =         {\doi{10.1088/0026-1394/51/3/169}},
keywords =     {general relativity, chemistry, molar mass},
mynote =       {\begin{quotation}The equivalent mass of the cohesive energy of a crystal of silicon or graphite reduces the mass of the crystal by parts in \num[print-unity-mantissa=false]{1e10} as compared to the mass of the same number of unbound atoms, assuming in both cases that the atoms are at rest and in their ground state. At room temperature, rather than absolute zero, the atoms in the crystal have thermal energy but the mass equivalent of this energy is much smaller than the cohesive energy of the crystal.\par These calculations show the importance of making a clear distinction between mass and amount of substance. The amount of substance of silicon-28 atoms, $n = N / N_{\textrm{A}}$, is the same in the two examples discussed in section~2 but the mass of this amount of substance changes slightly depending on whether the cohesive energy is zero (unbound atoms, approximated as a sufficiently dilute gas) or finite (atoms bound in a crystal).\end{quotation} \sect4 p.~172. \enquote{the precision of the most accurate \qty{1}{kg} mass comparators is roughly the same as the mass-energy equivalent of crystal cohesion.} \sect4 p.~173. \enquote{Even though atoms and electrons maintain their integrity as `entities' in chemical reactions, the total mass of the reactants does change, thus illustrating an important conceptual distinction between amount of substance and mass.} \sect4 p.~173. \enquote{the mass equivalent of chemical bonds in the \textins{silicon} crystal is approximately \qty{0.18}{\micro g} for a \qty{1}{kg} crystal.} Abstract p.~169}
}


author =       {A. Philip Dawid},
title =        {Taking prediction seriously},
journal =      bisi,
year =         {1993},
volume =       {55},
number =       {3},
pages =        {3--13},
keywords =     {exchangeability, extreme-point model, Bayes, sufficiency},
mynote =       {\begin{quotation}Most of statistical inference is framed in terms of statements about the parameters of probability distributions. This is a pretty safe enterprise. When we reject the null hypothesis that the mean $\theta$ of a normal distribution equals $0$, or set a confidence interval which is supposed likely, in some sense, to cover $0$, we are in little danger of being found wrong, because the true value of $0$ will never come to light. If we take seriously Karl Popper's view that a theory is only scientific if it is testable, and so potentially refutable, then we must conclude that a large part of what passes as statistical inference is not science, but metaphysics.\par If statisticians would aspire to scientific respectability, we should therefore be prepared to lay our heads on the line, and risk having them severed. The inferences we make should be about real, observable quantities.\end{quotation} p.~3}
}


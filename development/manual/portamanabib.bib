@Article{muelleretal2008,
author =       {J{\"u}rgen M{\"u}ller and Michael Soffel and Sergei A. Klioner},
title =        {Geodesy and relativity},
journal =      jg,
year =         {2008},
volume =       {82},
number =       {3},
pages =        {133--145},
note =         {\doi{10.1007/s00190-007-0168-7}},
keywords =     {general relativity, GPS},
mynote =       {\begin{quotation}To illustrate this point, let us consider a GPS satellite that moves at $3874\,\mathrm{m/s}$ with respect to the geocenter. According to \textins{special relativity}, clocks moving with speed $v$ are slowed by a factor of $\sqrt{1 - (v/c)^{2}} \simeq 1 - 8.3 \times 10^{-11}$ where $c$ is the speed of light in vacuum. This time dilation would cause a time error of $7.2\,\mathrm{\micro s}$ per day, and this should be compared with the accuracy of the GPS system time of some tens of nanoseconds.\par The contribution of \textins{general relativity} is even larger: $\sqrt{1 - 2\,\incr U/c^{2}} \simeq 1 + 5.28 \times 10^{-10}$, where $\incr U$ is the difference between the gravitational potential between the Earth's surface and satellite altitude. As the sign of the potential part is opposite to the sign of the velocity part, one obtains a total of $+4.45 \times 10^{-10}$. This means that GPS satellite clocks run faster by about $38\,\mathrm{\micro s}$ per day than the receiver clocks on Earth, which is corrected at the GPS satellite clocks.\end{quotation} \sect1 p.~134}
}


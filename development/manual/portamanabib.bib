@Article{berketal1991,
author =       {Richard A. Berk and Blalock, Jr., Hubert M. and William M. Mason and David A. Freedman},
title =        {Toward a Methodology for Mere Mortals. {Are} There Really Any Constructive Alternatives to Causal Modeling? {Freedman} is Right as Far as He Goes, but There is More, and It's Worse. {Statisticians} Could Help. {Rejoinder}},
journal =      socm,
year =         {1991},
volume =       {21},
pages =        {315--358},
note =         {See \citebi{freedman1991}},
keywords =     {probability theory, model comparison, causality, independence, linear regression},
mynote =       {\begin{quotation}\begin{enumerate}\item Low standards and weak curricula in undergraduate programs, leading to low-quality graduate students as measured by GRE scores \item Weak graduate training programs, containing few requirements and only very low-level required statistics courses that are not well integrated with more general methods courses \item An American student body that has virtually no interest in philosophy of science or theoretical issues but that is far more oriented to immediate applied problems of fashionable interest \item Compartmentalization of statistics/methods courses and theory courses, combined with inattention of ``theorists'' to matters of verification (Lenski 1988) \item An extreme splintering of the field into tiny subspecializations, many with highly applied orientations \item Continued nonproductive disputes between science-oriented and anti-science-oriented members of the profession, with the latter poised to take advantage of intellectual exchanges such as the present one \item Publication pressures favoring quick research and the use of secondary data sources, creating a vested interest in looking the other way and failing to conduct proper preliminary investigations \item Journal policies and professional norms that fail to discourage bad practices \item Inadequate funding for research combined with a lack of organizations capable of producing multifaceted, large-scale data sets\end{enumerate}\end{quotation} Blalock p.~333}
}


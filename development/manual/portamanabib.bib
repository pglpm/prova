@Article{lindleyetal1982,
author =       {Dennis Victor Lindley and Morris H. DeGroot and A. P. Dempster and Irving John Good and Bruce M. Hill and Robert E. Kass and Glenn Shafer},
title =        {{[}{Lindley's} Paradox{]} {Comments} and rejoinder},
journal =      jasa,
year =         {1982},
volume =       {77},
number =       {378},
pages =        {334--351},
note =         {See \citebi{shafer1982}},
keywords =     {evidence, Bayes, improper priors, diffuse priors, non-informative priors, rare events, measure theory, importance of conditional},
mynote =       {Hill: \enquote{Finally, I'd like to suggest that such words as ``evidence'' or ``belief'' not be used until one has specified the operational meaning to be attached to them. In physics and other highly developed sciences it has become largely accepted that words unaccompanied by operational meaning are suspect, and likely to prove meaningless \citex{bridgman1927_r1958}. This would seem to be particularly important in a less highly developed field such as statistics, where many are misled by terminology} p.~346. DeGroot: \enquote{I do not agree with the notion expressed by Shafer, and by many others before him, that a diffuse prior distribution represents ignorance about $\theta$, or with the statement that ``the more ignorant we are, the more diffuse'' the prior distribution should be. Indeed, a diffuse prior distribution, represented for example by a normal distribution with a very large variance, indicates not that I am totally ignorant about $\theta$ but that I am quite certain that $\lvert\theta\rvert$ is large. I doubt that the concept of total ignorance about $\theta$ has any precise meaning: If I am totally ignorant about $\theta$, then I am also totally ignorant about $\eta = \exp(\theta)/[1 + \exp(\theta)]$, but a diffuse distribution for $\theta$ indicates that $\eta$ is almost certainly near $0$ or $1$.} p.~337}
}


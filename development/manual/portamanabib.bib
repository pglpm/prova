author =       {{\textsc{iso}}},
organization = {International Organization for Standardization},
address =      {Geneva},
year =         {2009},
shortauthor =  {\textsc{iso}},
keywords =     {standard, probability theory, terminology, mechanics, mathematics},
mynote =       {\begin{quote}When a number is given without any further information, it is generally interpreted so that the last digit is rounded with a rounding range equal to 1 in the last digit (see Annex~B). Thus, for example, the number \num{401008} is generally assumed to represent a value between \num{401007,5} and \num{401008,5}. In this case, the maximum magnitude of the error in the number \num{401008} is \num{0,5}. However, in some applications rounding is replaced by truncation (i.e. by simply cutting off the last digits), e.g. \num{401008,91} becomes \num{401008}. In this case, the number \num{401008} represents a value between \num{401008,0} and \num{401009,0} and the error is between 0 and 1. Similarly, the number \num{40,1008} is generally assumed to represent a value between \num{40,10075} and \num{40,10085} or sometimes a value between \num{40,10080} and \num{40,10090}.\end{quote} \sect7.3.4}
}


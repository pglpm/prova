@InCollection{walker2013,
author =       {Stephen G. Walker},
title =        {Bayesian nonparametrics},
booktitle =    {\NoCaseChange{\citein{damienetal2013}}},
year =         {2013},
chapter =      {\chapb~13},
pages =        {249--270},
note =         {\doi{10.1093/acprof:oso/9780199695607.003.0013}},
mynote =       {Unfortunately he confuses logical independence with physical independence. \equote{I am trying to learn about something and have some current knowledge. My current knowledge is encapsulated in a small model. I learn through further observation that this small model is wrong or misguided. I must change it, whether the foundations for the inference I am undertaking allow me to do this or not. The current knowledge (knowledge prior to data) is being changed by the data. This cannot make any sense. Such knowledge should be updated, not changed then updated, by the data, and a framework should be established from the start that permits revisions of sufficiently large magnitude and variety. Large models, which are becoming increasingly better understood, can meet these needs.} \sect13.1 p.~249. \enquote{I construct $\Pi(\mathrm{d}f)$ and this means that $\Pi(f \in \Omega) = 1$ for some set of densities $\Omega$. So it has been stated that what is known without knowledge of the data is that the set of densities which could be generating the data lies in $\Omega$. If that is what is known then that is it. How can one measure this certainty in practice? What is the test? The test is that the model, namely $\Omega$ is not checked off with the data. It is clearly an internal contradiction, and a demonstration of irrational behaviour, to specify $\Omega$ and then check it. Checking it indicates that there is more uncertainty around than is being acknowledged by the use of $\Omega$. If this is the case, then $\Omega$ needs to be enlarged to appreciate the starting uncertainty properly.} \sect13.2 p.~252}
}


@Book{ziliaketal2008,
author =       {Stephen T. Ziliak and Deirdre N. McCloskey},
title =        {The Cult of Statistical Significance: How the Standard Error Costs Us Jobs, Justice, and Lives},
publisher =    {University of Michigan Press},
year =         {2008},
series =       {Economics, cognition, and society},
address =      {Ann Arbor, USA},
note =         {\doi{10.3998/mpub.186351}},
keywords =     {p-values, significance, corrupt research},
mynote =       {\enquote{Statistical significance is not a \emph{scientific} test. It is a philosophical, qualitative test. It does not ask how much. It asks ``whether.'' Existence, the question of whether, is interesting. But it is not scientific.} pp.~4--5. \enquote{A small sample, we repeat, is rarely the big scientific problem. Interpretation is.} p.~30. \enquote{Significance unfortunately is a useful means toward personal ends in the advance of science -- status and widely distributed publications, a big laboratory, a staff of research assistants, a reduction in teaching load, a better salary, the finer wines of Bordeaux. Precision, knowledge, and control. In a narrow and cynical sense statistical significance is the way to achieve these. Design experiment. Then calculate statistical significance. Publish articles showing ``significant'' results. Enjoy promotion.\par But it is not science, and it will not last.} p.~32. \enquote{The scientific objects therefore lie there still, undetected, in the dark.\par To which at last the sizeless scientist exclaims in anguish: ``Precisely! The dark is so very dark. What are we to \emph{do} if not calculations of statistical significance?'' We reply: you are to \emph{do} real science. Real science, unlike significance-testing science, is difficult. If it were not, it would not be real science, but instead it would be already established routine. Real science asks you to make real scientific judgments and real scientific arguments within a community of other scientists. It asks you to be quantitatively persuasive, not to be irrelevantly mechanical. Life is hard.} p.~55. \enquote{What does this mean? Johnston suggests that at a more rigorous level -- 1 percent -- you might not act on the result, \emph{although acting on it would have saved about 100,000 lives in the} United Kingdom over the period 1947--57.} p.~109}
}

